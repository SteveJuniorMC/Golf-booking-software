{
  "hosting": {
    "site": "yourteesheet",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "README.md",
      "firebase-debug.log",
      "firestore.rules",
      "firestore.indexes.json",
      "mockups/**",
      "demo/book.html",
      "demo/assets/book.js"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
